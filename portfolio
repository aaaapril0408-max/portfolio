                    const direction = Number(zone.dataset.direction);
                    window.clearInterval(autoScrollId);
                    autoScrollId = window.setInterval(() => {
                        const atStart = timeline.scrollLeft <= 4;
                        const atEnd = timeline.scrollLeft >= maxScroll() - 4;

                        if ((direction < 0 && atStart) || (direction > 0 && atEnd)) {
                            window.clearInterval(autoScrollId);
                            updateButtons();
                            return;
                        }

                        timeline.scrollLeft += direction * 6;
                        updateButtons();
                    }, 16);
                });
                zone.addEventListener('mouseleave', () => window.clearInterval(autoScrollId));
            });

            const aboutObserver = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        timeline.scrollTo({ left: 0, behavior: 'auto' });
                        updateButtons();
                    }
                });
            }, { threshold: 0.35 });

            aboutObserver.observe(about);
            updateButtons();
        };

        setupTimeline();

        const setupCopyButtons = () => {
            const copyButtons = document.querySelectorAll('[data-copy-email], [data-copy-text]');
            const toast = document.querySelector('[data-copy-toast]');
            let toastTimer = null;

            if (!copyButtons.length || !toast) return;

            const showToast = () => {
                window.clearTimeout(toastTimer);
                toast.classList.add('is-visible');
                toastTimer = window.setTimeout(() => {
                    toast.classList.remove('is-visible');
                }, 1600);
            };

            copyButtons.forEach((button) => {
                button.addEventListener('click', async () => {
                    const value = button.dataset.copyEmail || button.dataset.copyText;

                    try {
                        await navigator.clipboard.writeText(value);
                    } catch (error) {
                        const input = document.createElement('input');
                        input.value = value;
                        document.body.appendChild(input);
                        input.select();
                        document.execCommand('copy');
                        input.remove();
                    }

                    showToast();
                });
            });
        };

        setupCopyButtons();
    </script>

</body>
</html>
