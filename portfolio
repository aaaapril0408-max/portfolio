            if (!about || !timeline || !prevButton || !nextButton) return;

            const maxScroll = () => Math.max(0, timeline.scrollWidth - timeline.clientWidth);
            const updateButtons = () => {
                const atStart = timeline.scrollLeft <= 4;
                const atEnd = timeline.scrollLeft >= maxScroll() - 4;
                prevButton.classList.toggle('is-disabled', atStart);
                nextButton.classList.toggle('is-disabled', atEnd);
            };
            const scrollByPage = (direction) => {
                const atStart = timeline.scrollLeft <= 4;
                const atEnd = timeline.scrollLeft >= maxScroll() - 4;

                if (direction < 0 && atStart) {
                    return;
                }

                if (direction > 0 && atEnd) {
                    return;
                }

                timeline.scrollBy({ left: direction * timeline.clientWidth * 0.78, behavior: 'smooth' });
            };

            prevButton.addEventListener('click', () => scrollByPage(-1));
            nextButton.addEventListener('click', () => scrollByPage(1));
            timeline.addEventListener('scroll', updateButtons);
